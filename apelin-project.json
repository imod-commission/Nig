{
  "schemaVersion": 1,
  "projectID": "c6eb2e2e-33f4-4171-8b22-5b631b0159b9",
  "kind": "tweak",
  "template": {
    "extensionID": "wiki.qaq.apelin.dev.tweak",
    "templateID": "objc-hook",
    "version": "0.1.1",
    "digest": "sha256:f7aa0129fcb88ba57ea493d55f34828fd0bc1a435e5a0e3145dedf16118d4dc6"
  },
  "environment": {
    "toolchain": {
      "id": "f88a63eda7caa77b5dc1f336",
      "digest": "sha256:346ee937396ee5e2ecbdd916c79b315252e18726db08abc28c0fbdff96fe5fab"
    },
    "sdk": {
      "id": "iphoneos17.4-8618351c",
      "digest": "sha256:8618351cbc242b134f8f6a7585d7d689e29ab148be51f5fe24eb07c26cd67983"
    }
  },
  "language": "objc",
  "deploymentTarget": "16.0",
  "architectures": {
    "rootless": [
      "arm64",
      "arm64e"
    ],
    "roothide": [
      "arm64e"
    ]
  },
  "configurations": {
    "Debug": {
      "optimization": "0",
      "debugInfo": true,
      "defines": {
        "DEBUG": "1"
      }
    },
    "Release": {
      "optimization": "2",
      "debugInfo": true
    }
  },
  "products": [
    {
      "id": "tweak",
      "type": "dylib",
      "name": "Nig",
      "sources": [
        "Sources/*.m"
      ],
      "headerSearchPaths": [
        "Sources",
        "Shared"
      ],
      "objcARC": true,
      "frameworks": [
        "Foundation",
        "UIKit",
        "QuartzCore",
        "CoreGraphics",
        "Vision"
      ],
      "libraries": [
        "substrate"
      ],
      "extensionSupport": [
        {
          "extension": "wiki.qaq.apelin.dev.tweak",
          "component": "substrate"
        }
      ]
    },
    {
      "id": "prefs",
      "type": "bundle",
      "name": "NigPrefs",
      "sources": [
        "Prefs/Sources/*.m"
      ],
      "headerSearchPaths": [
        "Prefs/Sources",
        "Shared"
      ],
      "resources": [
        "Prefs/Resources/Root.plist",
        "Prefs/Resources/icon.png",
        "Prefs/Resources/icon@2x.png",
        "Prefs/Resources/icon@3x.png"
      ],
      "infoPlist": "Prefs/Resources/Info.plist",
      "objcARC": true,
      "frameworks": [
        "Foundation",
        "UIKit",
        "Preferences"
      ],
      "extensionSupport": [
        {
          "extension": "wiki.qaq.apelin.dev.preferences",
          "component": "preferences"
        }
      ]
    }
  ],
  "build": {
    "steps": [
      {
        "type": "compile",
        "product": "tweak"
      },
      {
        "type": "link",
        "product": "tweak"
      },
      {
        "type": "lipo",
        "product": "tweak"
      },
      {
        "type": "dsym",
        "product": "tweak"
      },
      {
        "type": "strip",
        "product": "tweak",
        "style": "non-global"
      },
      {
        "type": "sign",
        "product": "tweak",
        "identity": "adhoc"
      },
      {
        "type": "compile",
        "product": "prefs"
      },
      {
        "type": "link",
        "product": "prefs"
      },
      {
        "type": "bundle-resources",
        "product": "prefs"
      },
      {
        "type": "lipo",
        "product": "prefs"
      },
      {
        "type": "dsym",
        "product": "prefs"
      },
      {
        "type": "strip",
        "product": "prefs",
        "style": "non-global"
      },
      {
        "type": "sign",
        "product": "prefs",
        "identity": "adhoc"
      }
    ]
  },
  "package": {
    "id": "com.imodcommission.nig",
    "name": "Nig",
    "version": "1.0.0",
    "description": "Night mode for unsupported apps and websites!",
    "icon": "https://raw.githubusercontent.com/imod-commission/Nig/main/assets/icon.png",
    "author": "imod_commission",
    "section": "Tweaks",
    "depends": [
      "mobilesubstrate",
      "preferenceloader"
    ],
    "layout": [
      {
        "path": "/Library/MobileSubstrate/DynamicLibraries/Nig.dylib",
        "product": "tweak"
      },
      {
        "path": "/Library/PreferenceBundles/NigPrefs.bundle",
        "product": "prefs"
      },
      {
        "path": "/Library/PreferenceBundles/NigPrefs.bundle/en.lproj/Root.strings",
        "file": "Prefs/Localizations/en.lproj/Root.strings",
        "mode": "0644"
      },
      {
        "path": "/Library/PreferenceBundles/NigPrefs.bundle/ja.lproj/Root.strings",
        "file": "Prefs/Localizations/ja.lproj/Root.strings",
        "mode": "0644"
      },
      {
        "path": "/Library/PreferenceBundles/NigPrefs.bundle/zh-Hans.lproj/Root.strings",
        "file": "Prefs/Localizations/zh-Hans.lproj/Root.strings",
        "mode": "0644"
      },
      {
        "path": "/Library/PreferenceBundles/NigPrefs.bundle/zh-Hant.lproj/Root.strings",
        "file": "Prefs/Localizations/zh-Hant.lproj/Root.strings",
        "mode": "0644"
      },
      {
        "path": "/Library/PreferenceLoader/Preferences/NigPrefs.plist",
        "file": "Prefs/Packaging/entry.plist",
        "mode": "0644"
      }
    ],
    "tweakFilter": {
      "dylib": "tweak",
      "classes": [
        "UIApplication"
      ]
    },
    "longDescription": [
      "Night mode for apps and websites that do not have a dark theme.",
      "Nig follows the system appearance: when iOS is in Dark mode it recolours",
      "UIKit apps and the web pages shown in Safari, in-app browsers and web views.",
      "Dark colours become a lighter shade of the same hue, photos and QR codes are left alone.",
      "Exclude a single app with Choicy, or a website in the Nig settings pane.",
      "Nig cannot recolour apps that draw their own UI (Flutter, games, some cross-platform apps)",
      "and it does not work in every app: some will look wrong or be left unchanged.",
      "Packages for rootless and roothide jailbreaks."
    ]
  }
}
