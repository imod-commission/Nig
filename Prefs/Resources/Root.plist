<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>Nig</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Dark mode</string>
			<key>footerText</key>
			<string>Nig follows the system appearance: it only works while iOS is in Dark mode. Turn it off here to leave every app as it is. To exclude a single app, use Choicy.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enabled</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.imodcommission.nig</string>
			<key>PostNotification</key>
			<string>com.imodcommission.nig/changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Web pages</string>
			<key>footerText</key>
			<string>Recolours web pages shown inside apps (in-app browsers and web views). Turn it off if a page looks wrong.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Recolour web pages</string>
			<key>key</key>
			<string>web</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.imodcommission.nig</string>
			<key>PostNotification</key>
			<string>com.imodcommission.nig/changed</string>
		</dict>
	</array>
</dict>
</plist>
